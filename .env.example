# Copy this file to .env.local for local development,
# and add the same values in Vercel -> Settings -> Environment Variables.

# ---- Sign-in ---------------------------------------------------------------

# The username and password you start with.
#
# These two defaults apply to local development only. Once deployed
# (NODE_ENV=production) both must be set, or sign-in is switched off and the
# login page says so. They are never used as a fallback on a live site.
APP_USERNAME=admin
APP_PASSWORD=pvc2024

# A long random string used to sign the login cookie. Changing it signs
# everyone out. Required in production, 32 characters or more:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars


# ---- Self-service password change (optional) -------------------------------
#
# Add an Upstash database in Vercel (Storage -> Marketplace -> Upstash for
# Redis). Vercel fills these two in for you. With them set, you can change your
# password inside the app and it sticks, instead of editing APP_PASSWORD here.
#
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# The key that lets you reset a forgotten password from the sign-in page.
# Treat it like a spare key: long, random, and stored somewhere safe.
# Without it, "Forgotten your password?" stays switched off.
# RECOVERY_KEY=
